<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Coldbox · Mobile entropy candidate</title><style>
@import url('https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&display=swap');:root{--ink:#121212;--paper:#fffdf5;--yellow:#ffde59;--cyan:#00e4f2;--pink:#ff007a;--nav:#232331;--muted:#b3bcd4;--green:#4ade80}*{box-sizing:border-box}body{margin:0;background:#1a1a24;background-image:radial-gradient(#2d2d3f 14%,transparent 15%),radial-gradient(#2d2d3f 14%,transparent 15%);background-size:20px 20px;background-position:0 0,10px 10px;color:var(--paper);font:700 15px 'Comic Neue',system-ui,sans-serif}.bang{font-family:Bangers,Impact,sans-serif;letter-spacing:.05em;text-transform:uppercase}button,input{font:inherit}button{cursor:pointer;border:3px solid var(--ink);border-radius:6px;box-shadow:4px 4px 0 var(--ink);min-height:44px;color:var(--ink)}button:focus-visible,input:focus-visible{outline:3px solid var(--pink);outline-offset:3px}header{display:flex;align-items:center;gap:8px;padding:9px 12px;background:var(--yellow);border-bottom:3px solid var(--ink);box-shadow:0 5px 0 var(--ink);color:var(--ink)}.brand{font-size:28px;color:var(--cyan);text-shadow:.055em .055em 0 var(--ink),-.035em -.035em 0 var(--ink)}.pre{font:11px Bangers;background:var(--pink);padding:3px 6px;border:2px solid var(--ink);transform:rotate(3deg)}.header-action{margin-left:auto;background:var(--ink);color:var(--yellow);padding:6px 9px;font:15px Bangers}.strip{padding:9px 12px;background:#e8f9ff;color:var(--ink);border-bottom:3px solid var(--ink);font-size:11px}.live{display:inline-block;padding:2px 7px;margin-right:5px;border:2px solid var(--ink);background:var(--green);font:12px Bangers}.content{padding:16px 12px 32px}.eyebrow{display:inline-block;padding:2px 8px;background:var(--yellow);border:2px solid var(--ink);box-shadow:2px 2px 0 var(--ink);color:var(--ink);font:12px Bangers}.title{margin:10px 0 4px;font-size:39px;line-height:.95;text-shadow:.06em .06em 0 var(--ink)}.intro{margin:8px 0 14px;color:var(--muted);font-size:13px;line-height:1.45}.steps{display:flex;gap:6px;overflow:auto;padding:0 0 6px;margin-bottom:12px}.step{flex:0 0 auto;padding:7px 10px;background:#252536;color:var(--paper);border-color:var(--paper);font:14px Bangers;box-shadow:3px 3px 0 var(--ink)}.step.current{background:var(--pink)}.card{background:var(--paper);color:var(--ink);border:3px solid var(--ink);border-radius:8px;box-shadow:6px 6px 0 var(--ink);padding:13px}.card[hidden]{display:none}.card h2{margin:7px 0;font:31px Bangers}.copy{margin:6px 0 13px;color:#4e4a43;font-size:13px;line-height:1.4}.badge{display:inline-block;padding:2px 7px;background:var(--yellow);border:2px solid var(--ink);font:11px Bangers}.choice-row{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:10px 0}.choice{padding:8px 7px;background:var(--paper);font:15px Bangers}.choice.active{background:var(--pink);color:var(--paper)}.entry{padding:11px;border:2px dashed #aaa398}.entry h3{margin:0 0 7px;font:22px Bangers}.entry label{display:block;font-size:12px;margin:5px 0 4px}.entry input{width:100%;padding:9px;border:3px solid var(--ink);border-radius:4px;background:#fff;color:var(--ink);font-family:ui-monospace,monospace}.row{display:flex;gap:7px}.row button,.action{padding:8px 11px;background:var(--cyan);font:15px Bangers;white-space:nowrap}.helper{margin:6px 0 0;color:#686158;font-size:11px;line-height:1.3}.source-list{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}.source{padding:7px 9px;background:var(--paper);font:14px Bangers}.source.active{background:var(--pink);color:var(--paper)}.coin-row{display:flex;gap:8px}.coin-row button{flex:1;background:var(--yellow);font:16px Bangers}.log{list-style:none;margin:10px 0;padding:0;max-height:145px;overflow:auto}.log li{padding:6px 0;border-bottom:1px dotted #aaa398;font-size:11px}.log .name{font:13px Bangers;display:inline-block;min-width:57px}.stats{border-top:2px solid #aaa398;padding-top:7px}.stat{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px dotted #aaa398;font-size:11px}.stat b{font:11px ui-monospace,monospace}.status{margin-top:10px;padding:8px;border-left:7px solid var(--yellow);background:#fff9dd;color:var(--ink);font-size:11px;line-height:1.35}.status.ok{border-left-color:var(--green);background:#edfff2}.footer{display:flex;justify-content:space-between;gap:8px;margin-top:13px;padding-top:10px;border-top:2px dashed #aaa398}.footer button{padding:8px 12px;background:var(--paper);font:16px Bangers}.footer .next{background:var(--yellow)}.review{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.review div{padding:10px;border:2px dashed #aaa398}.review strong{display:block;font:21px Bangers}.check{padding:0;margin:10px 0;list-style:none}.check li{padding:8px 0;border-bottom:1px dotted #aaa398;font-size:12px}.check li:before{content:'✓';display:inline-grid;place-items:center;width:20px;height:20px;margin-right:6px;border:2px solid var(--ink);background:var(--green)}.action{margin-top:9px;background:var(--cyan)}
</style></head><body><header><span class="brand bang">Coldbox</span><span class="pre bang">Pre-release</span><button class="header-action bang">Panic</button></header><div class="strip"><span class="live bang">Live</span><span class="mono">Everyday child · fp 7B21D904 · sealed realm</span></div><main class="content"><span class="eyebrow bang">Forge · P1.1</span><h1 class="title bang">Entropy lab</h1><p class="intro">Collect, review, mix, and hand off auditable randomness without leaving the sealed realm.</p><div class="steps"><button class="step bang" data-step="1">1 · Target</button><button class="step current bang" data-step="2">2 · Sources</button><button class="step bang" data-step="3">3 · Collect</button><button class="step bang" data-step="4">4 · Health</button><button class="step bang" data-step="5">5 · Mix</button><button class="step bang" data-step="6">6 · Hand off</button></div>
<section class="card" id="step2"><span class="badge bang">Forge · P1.1</span><h2>Choose any combination</h2><p class="copy">Add physical observations one at a time. Each source keeps its own score, and the ledger stays visible.</p><div class="source-list"><button class="source active" data-source="dice">Dice</button><button class="source" data-source="coins">Coins</button><button class="source" data-source="cards">Cards</button><button class="source" data-source="hex">Hex</button><button class="source" data-source="csprng">CSPRNG</button></div><div class="entry"><div id="dice-entry"><h3>Record a die roll</h3><label for="dice">Faces, separated by spaces</label><div class="row"><input id="dice" placeholder="4 2 6"><button id="add-dice" class="action bang">Add</button></div></div><div id="coins-entry" hidden><h3>Record a coin flip</h3><div class="coin-row"><button data-coin="Heads" class="bang">Heads</button><button data-coin="Tails" class="bang">Tails</button></div></div><div id="cards-entry" hidden><h3>Record a card</h3><p class="helper">Use the compact card picker below.</p><div class="choice-row" id="cards"></div></div><div id="hex-entry" hidden><h3>Record hex digits</h3><label for="hex">Observed digits</label><div class="row"><input id="hex" placeholder="9f2c41a7"><button id="add-hex" class="action bang">Add</button></div></div><div id="csprng-entry" hidden><h3>Draw the system source</h3><button id="add-csprng" class="action bang">Draw 32 bytes</button></div><div class="status" id="status">Start by recording one or more physical observations.</div></div><div class="entry" style="margin-top:10px"><h3>Collection ledger</h3><ul class="log" id="log"><li class="helper">No entropy recorded yet.</li></ul><div class="stats"><div class="stat"><span>Sources chosen</span><b id="chosen">none</b></div><div class="stat"><span>Combined so far</span><b id="bits">0 bits</b></div><div class="stat"><span>Target</span><b id="target">224 bits · 21 words</b></div><div class="stat"><span>Remaining</span><b id="remain">224 bits</b></div></div></div><div class="footer"><button class="bang" data-go="1">Back</button><button class="next bang" data-go="3">Next step</button></div></section>
<section class="card" id="step1" hidden><span class="badge bang">Forge · P1.1</span><h2>Set the target</h2><p class="copy">Choose the output strength before collecting.</p><div class="choice-row"><button class="choice target active" data-words="21">21 words · 224 bits</button><button class="choice target" data-words="12">12 words · 128 bits</button><button class="choice target" data-words="15">15 words · 160 bits</button><button class="choice target" data-words="18">18 words · 192 bits</button><button class="choice target" data-words="24">24 words · 256 bits</button></div><div class="review"><div><span class="helper">Output</span><strong id="out-words">21 words</strong><span class="mono" id="out-bits">224 bits required</span></div><div><span class="helper">Record</span><strong>Everyday child</strong><span class="mono">7B21D904 · BIP-85</span></div></div><div class="status ok" id="target-status">Target selected and ready for collection.</div><div class="footer"><button class="bang" data-go="2">Back</button><button class="next bang" data-go="2">Confirm target</button></div></section>
<section class="card" id="step3" hidden><span class="badge bang">Forge · P1.1</span><h2>Review every entry</h2><p class="copy">Confirm the ordered source logs before health review.</p><ul class="check"><li>Every observation keeps its source label.</li><li>Counts and bit scores match the ledger.</li><li>The CSPRNG draw is present for the final mix.</li></ul><div class="review"><div><span class="helper">Current ledger</span><strong id="collect-bits">0 bits</strong></div><div><span class="helper">Boundary</span><strong>Sealed</strong><span class="mono">connect-src 'none'</span></div></div><div class="footer"><button class="bang" data-go="2">Back</button><button class="next bang" data-go="4">Review health</button></div></section>
<section class="card" id="step4" hidden><span class="badge bang">Forge · P1.1</span><h2>Check collection health</h2><p class="copy">Pause before mixing and confirm the required inputs.</p><ul class="check"><li>Physical source coverage is visible.</li><li id="mobile-csprng">CSPRNG draw is required before hand-off.</li><li>The sealed realm has no network primitive.</li></ul><div class="status" id="mobile-health">Add a CSPRNG draw in Sources, then return here.</div><div class="footer"><button class="bang" data-go="3">Back</button><button class="next bang" data-go="5">Continue to mix</button></div></section>
<section class="card" id="step5" hidden><span class="badge bang" style="background:var(--pink);color:#fff">Forge · P1.1</span><h2>Mix before hand-off</h2><p class="copy">XOR all selected sources with the sealed CSPRNG draw.</p><div class="review"><div><span class="helper">Inputs</span><strong id="mix-bits">0 bits</strong><span class="mono">physical + CSPRNG</span></div><div><span class="helper">Mixer</span><strong>XOR</strong><span class="mono">sealed local operation</span></div></div><div class="status" id="mobile-mix">Mixing is explicit and cannot be skipped.</div><button class="action bang" id="mobile-mix-action">Mix entropy</button><div class="footer"><button class="bang" data-go="4">Back</button><button class="next bang" id="mobile-handoff" data-go="6" disabled>Continue to hand-off</button></div></section>
<section class="card" id="step6" hidden><span class="badge bang">Forge · P1.1</span><h2>Hand off to Seed Forge</h2><p class="copy">The mixed result is ready for the next sealed step. No secret bytes are shown.</p><div class="review"><div><span class="helper">Result</span><strong>Mixed and sealed</strong><span class="mono">local entropy handle</span></div><div><span class="helper">Destination</span><strong>Seed Forge</strong><span class="mono">P1.3</span></div></div><div class="status ok">Hand-off is available to Seed Forge.</div><button class="action bang" data-go="1">Open Seed Forge</button><div class="footer"><button class="bang" data-go="5">Back</button><button class="next bang" data-go="1">Start another collection</button></div></section></main>
<script>const rates={dice:2.58,coins:1,cards:5.7,hex:4,csprng:8},names={dice:'Dice',coins:'Coins',cards:'Cards',hex:'Hex',csprng:'CSPRNG'},records=[];let targetBits=224,targetWords=21,mixed=false;const q=id=>document.getElementById(id);function render(){const total=records.reduce((n,r)=>n+rates[r.t]*r.n,0),types=[...new Set(records.map(r=>r.t))];q('chosen').textContent=types.length?types.map(t=>names[t]).join(' + '):'none';q('bits').textContent=(Math.round(total*10)/10)+' bits';q('remain').textContent=Math.max(0,Math.round((targetBits-total)*10)/10)+' bits';q('target').textContent=targetBits+' bits · '+targetWords+' words';q('log').innerHTML=records.length?records.slice().reverse().map(r=>'<li><span class="name">'+names[r.t]+'</span><span class="mono">'+r.v+'</span><span style="float:right">'+r.n+' × '+rates[r.t]+' bits</span></li>').join(''):'<li class="helper">No entropy recorded yet.</li>';q('collect-bits').textContent=(Math.round(total*10)/10)+' bits';q('mix-bits').textContent=(Math.round(total*10)/10)+' bits';const ok=records.some(r=>r.t==='csprng');q('mobile-csprng').textContent=ok?'CSPRNG draw is present for the required final mix.':'CSPRNG draw is required before hand-off.';q('mobile-health').textContent=ok?'Collection health is ready. Continue to the explicit XOR mix.':'Add a CSPRNG draw in Sources, then return here.'}function add(t,v,n=1){records.push({t,v,n});render();q('status').textContent='Recorded locally. Keep adding sources until the target is met.';q('status').className='status ok'}function show(n){document.querySelectorAll('[id^=step]').forEach(x=>x.hidden=x.id!=='step'+n);document.querySelectorAll('[data-step]').forEach(x=>x.classList.toggle('current',+x.dataset.step===+n));render();if(n===5){q('mobile-mix').textContent=mixed?'Entropy has been mixed with the sealed CSPRNG.':'Mixing is explicit and cannot be skipped.';q('mobile-handoff').disabled=!mixed}}document.querySelectorAll('[data-step],[data-go]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.step||b.dataset.go)));document.querySelectorAll('[data-source]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-source]').forEach(x=>x.classList.toggle('active',x===b));['dice','coins','cards','hex','csprng'].forEach(x=>q(x+'-entry').hidden=x!==b.dataset.source)}));q('add-dice').onclick=()=>{const v=q('dice').value.trim();if(!v)return;q('dice').value='';add('dice',v,v.split(/[ ,]+/).length)};document.querySelectorAll('[data-coin]').forEach(b=>b.onclick=()=>add('coins',b.dataset.coin));q('add-hex').onclick=()=>{const v=q('hex').value.trim();if(!/^[0-9a-f]+$/i.test(v))return;q('hex').value='';add('hex',v.toUpperCase(),v.length)};q('add-csprng').onclick=()=>add('csprng','32-byte sealed draw',32);['A♠','2♠','3♠','4♠','5♠','6♠'].forEach(v=>{const b=document.createElement('button');b.className='choice';b.textContent=v;b.onclick=()=>{b.disabled=true;b.classList.add('active');add('cards',v)};q('cards').appendChild(b)});document.querySelectorAll('.target').forEach(b=>b.onclick=()=>{targetWords=+b.dataset.words;targetBits={12:128,15:160,18:192,21:224,24:256}[targetWords];document.querySelectorAll('.target').forEach(x=>x.classList.toggle('active',x===b));q('out-words').textContent=targetWords+' words';q('out-bits').textContent=targetBits+' bits required';q('target-status').textContent='Target selected and ready for collection.';render()});q('mobile-mix-action').onclick=()=>{if(!records.some(r=>r.t==='csprng')){show(2);return}mixed=true;q('mobile-mix').textContent='Entropy has been mixed with the sealed CSPRNG.';q('mobile-mix').className='status ok';q('mobile-handoff').disabled=false};show(2);</script></body></html>
