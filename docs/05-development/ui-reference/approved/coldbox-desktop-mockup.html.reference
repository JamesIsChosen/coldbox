ffero General Public License is a free, copyleft license for\\nsoftware and other kinds of works, specifically designed to ensure\\ncooperation with the community in the case of network server software.\\n\\n  … the remaining sections are embedded verbatim in the built file, byte-identical to the repository LICENSE, and reachable with no network.',\n\n      hashRows: [\n        { k: 'Expected — recorded by the build', v: '7fa41c9d3981dd5addd360c5aed06390294526b8c433e5f27e849b20ffd8891e', border: '#121212', color: '#121212' },\n        { k: 'Computed — read from the dropped file', v: '7fa41c9d3981dd5addd360c5aed06390294526b8c433e5f27e849b20ffd8891e', border: '#0f6b45', color: '#0f6b45' },\n        { k: 'File', v: 'coldbox-v1.0.0.html · 1,094,321 bytes', border: '#121212', color: '#121212' },\n        { k: 'Algorithm', v: 'sha-256 · WebCrypto, in this page', border: '#121212', color: '#5c5344' }\n      ],\n      verifySteps: [\n        { n: '1', label: 'Hash the file yourself, outside the browser', cmd: 'shasum -a 256 coldbox-v1.0.0.html\\ncertutil -hashfile coldbox-v1.0.0.html SHA256' },\n        { n: '2', label: 'Compare against the .sha256 published with the release', cmd: 'diff <(shasum -a 256 coldbox-v1.0.0.html) coldbox-v1.0.0.html.sha256' },\n        { n: '3', label: 'Verify the detached GPG signature', cmd: 'gpg --verify coldbox-v1.0.0.html.asc coldbox-v1.0.0.html' },\n        { n: '4', label: 'Or rebuild it and confirm identical bytes', cmd: 'npm run build && shasum -a 256 build/coldbox.html' }\n      ],\n\n      goEmpty: () => this.setState({ screen: 'empty' }),\n      sessionBadge: 'Session: unlocked', sessionBadgeBg: '#4ade80',\n      sessionLine: 'Bitcoin savings · vault 8F2C-41A7 · unlocked 13:41',\n      sessionNote: 'The realm locks itself after five minutes without activity, or on Escape twice.',\n      vaultCount: VAULTS.length,\n      vaults: VAULTS.map((v, i) => ({\n        name: v.name, id: v.id, state: v.state, stateBg: v.stateBg, stateInk: v.stateInk, meta: v.meta,\n        warning: v.warning, hasWarning: !!v.warning,\n        style: 'padding:15px 16px;border:3px solid ' + (v.state === 'Unlocked' ? '#4ade80' : '#121212')\n          + ';border-radius:9px;background:' + paperStocks[i % 3] + ';box-shadow:7px 7px 0 #000;color:#121212',\n        actions: v.actions.map(a => ({\n          label: a[0],\n          go: a[0] === 'Unlock' ? this.nav('empty') : a[0] === 'Lock' ? this.nav('lock') : this.nav('unlock'),\n          style: 'padding:8px 13px;border:' + (a[1] === '#fffdf5' ? '2px' : '3px') + ' solid #121212;border-radius:6px;background:'\n            + a[1] + ';box-shadow:3px 3px 0 #121212;color:' + (a[1] === '#e02020' ? '#ffffff' : '#121212')\n            + \";cursor:pointer;font-family:'Bangers',sans-serif;font-weight:400;letter-spacing:.05em;text-transform:uppercase;font-size:15px;min-height:44px\"\n        }))\n      })),\n      createPanelStyle: 'padding:18px 19px 19px;border:3px solid #121212;border-radius:9px;background:#e8f9ff;box-shadow:8px 8px 0 #000;color:#121212',\n      createFields: [\n        { label: 'Public vault name', value: 'Hardware wallet records', border: '#121212', spacing: 'normal', help: 'Public. It appears in the filename and the library list, so never put a phrase, a seed word or a key here.', helpColor: '#5c5344' },\n        { label: 'Unlock phrase (never leaves this realm)', value: '••••••••••••••••••••••••', border: '#121212', spacing: '.14em', help: 'Six Diceware words or more. Coldbox does not invent a numeric strength score from your spelling or length.', helpColor: '#5c5344' },\n        { label: 'Confirm unlock phrase', value: '••••••••••••••••••••••••', border: '#0f6b45', spacing: '.14em', help: 'Match — the two entries agree.', helpColor: '#0f6b45' }\n      ],\n      kdfProfiles: ['Interactive', 'Moderate', 'Paranoid'].map((n, i) => ({\n        name: n, spec: ['64 MiB · 0.38 s', '256 MiB · 1.42 s', '1 GiB · 4.10 s'][i],\n        go: () => this.setState({ kdf: i }),\n        style: 'padding:9px 12px;border:' + (s.kdf === i ? '3px' : '2px') + ' solid #121212;border-radius:6px;background:'\n          + (s.kdf === i ? '#00f0ff' : '#fff') + ';box-shadow:' + (s.kdf === i ? '4px 4px 0 #121212' : '2px 2px 0 #121212')\n          + ';color:#121212;cursor:pointer;text-align:left;min-height:48px'\n      })),\n      kdfNote: ['Fast enough to unlock on a phone. Weakest against an offline guessing attack.',\n        'The default. Roughly a second and a half on this machine, and a serious cost to an attacker per guess.',\n        'Four seconds per unlock here, and four seconds per guess for anyone else. Check it on your slowest device first.'][s.kdf],\n      keyfileMark: s.keyfile ? '✓' : '',\n      depthTabs: ['Plain', 'Working', 'Technical'].map((d, i) => ({\n        label: d, go: () => this.setState({ depth: i }), style: this.pill(s.depth === i, '#ffde59')\n      })),\n      depthLabel: ['plain', 'working', 'technical'][s.depth],\n      guides: GUIDES.map((g, i) => ({\n        n: g[0], title: g[1], body: g[2], meta: g[3],\n        style: 'padding:14px 15px;border:3px solid #121212;border-radius:9px;background:' + paperStocks[i % 3] + ';box-shadow:7px 7px 0 #000'\n      })),\n      glossary: GLOSSARY.map(t => ({ term: t[0], tag: t[1], def: t[2][s.depth] })),\n\n      groupTabs: coldGroups.map(g => ({\n        label: g[1] + ' · ' + g[2].length, go: () => this.setState({ group: g[1].toLowerCase() }),\n        style: this.pill(s.group === g[1].toLowerCase())\n      })),\n      fanCards: hubCards,\n      hubMore: activeGroup[2].slice(4).map(it => ({\n        label: it[0] + ' · ' + it[1], go: this.nav(it[2]),\n        style: 'display:flex;align-items:center;gap:7px;padding:7px 11px;border:2px solid '\n          + (it[3] === 1 ? '#4ade80' : it[3] === 2 ? '#ffde59' : '#4a4a63') + ';border-radius:6px;background:#1e1e2b;color:'\n          + (it[3] === 3 ? '#b3bcd4' : '#fffdf5') + ';cursor:pointer;font-size:11.5px;min-height:40px'\n      })),\n      hasMore: activeGroup[2].length > 4,\n      hubCue: 'cards open with ' + sec.label + ' already loaded',\n      isMap: sc.kind === 'map',\n      mapColumns: [\n        { realm: 'Sealed realm', tint: '#ff007a', groups: ITEMS.filter(g => g[0] === 'cold') },\n        { realm: 'Warm shell', tint: '#00f0ff', groups: ITEMS.filter(g => g[0] === 'warm') }\n      ].map(col => ({\n        realm: col.realm,\n        badgeStyle: 'display:inline-block;padding:3px 10px;border:2px solid #000;background:' + col.tint\n          + \";box-shadow:3px 3px 0 #000;color:#121212;font-family:'Bangers',sans-serif;font-weight:400;letter-spacing:.05em;text-transform:uppercase;font-size:16px\",\n        count: col.groups.reduce((n, g) => n + g[2].length, 0) + ' items · ' + col.groups.length + ' groups',\n        groups: col.groups.map((g, gi) => ({\n          name: g[1], count: g[2].length + ' items',\n          style: 'padding:14px 15px;border:3px solid #121212;border-radius:9px;background:' + paperStocks[gi % 3] + ';box-shadow:7px 7px 0 #000',\n          chips: g[2].map(it => ({\n            phase: it[0], label: it[1], go: this.nav(it[2]),\n            style: 'display:flex;align-items:center;gap:8px;width:100%;padding:7px 9px;border:2px solid #121212;border-radius:6px;background:'\n              + (it[3] === 1 ? '#fff' : it[3] === 2 ? '#ffde59' : '#efece2') + ';box-shadow:2px 2px 0 #121212;color:#121212;cursor:pointer;text-align:left;min-height:40px',\n            phaseStyle: 'flex:0 0 62px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:10.5px;color:'\n              + (it[3] === 1 ? '#0f6b45' : it[3] === 2 ? '#8a6100' : '#5c5344')\n          }))\n        }))\n      })),\n      mapTotal: ITEMS.reduce((n, g) => n + g[2].length, 0),\n\n      gatePanelStyle: 'padding:19px 20px 20px;border:3px solid ' + (s.screen === 'lock' ? '#e02020' : '#121212')\n        + ';border-radius:9px;background:#fffdf5;box-shadow:8px 8px 0 #000;color:#121212',\n      gateBadge: gate.badge, gateBadgeBg: gate.badgeBg, gateTitle: gate.title,\n      gateFields: (gate.fields || []).map(f => ({ label: f[0], value: f[1], help: f[2] })),\n      gateButtons: (gate.buttons || []).map(b => ({\n        label: b[0], go: b[0].indexOf('Forge') === 0 ? this.nav('forge') : b[0].indexOf('Unlock') === 0 ? this.nav('empty') : b[0].indexOf('Cancel') === 0 ? this.nav('hub') : this.nav('secret'),\n        style: 'padding:10px 17px;border:3px solid #121212;border-radius:7px;background:' + b[1] + ';box-shadow:4px 4px 0 #121212;color:'\n          + b[2] + \";cursor:pointer;font-family:'Bangers',sans-serif;font-weight:400;letter-spacing:.05em;text-transform:uppercase;font-size:18px;min-height:48px\"\n      })),\n      gateNotes: (gate.notes || []).map((n, i) => ({\n        badge: n[0], badgeBg: n[1], body: n[2], data: n[3], hasData: !!n[3],\n        style: 'padding:15px;border:3px solid #121212;border-radius:9px;background:' + (i ? '#fff2f7' : '#e8f9ff') + ';box-shadow:7px 7px 0 #000'\n      })),\n\n      words,\n      wordPanelKicker: sc.childMode ? \"Child phrase · m/83696968'/39'/0'/24'/3'\" : 'Phrase · ' + sec.label,\n      wordMeta: (sc.kind === 'forge' ? forgeWordCount : sec.words) + ' words · '\n        + FORGE_LANG[s.forgeLang || 0] + ' · ' + FORGE_LEN[s.forgeLen === undefined ? 4 : s.forgeLen][0] + ' bits · checksum valid',\n      wordPanelStyle: 'padding:17px 18px 18px;border:3px solid ' + (s.revealed ? '#e02020' : '#121212')\n        + ';border-radius:9px;background:#fffdf5;box-shadow:8px 8px 0 #000;color:#121212'\n        + (s.revealed ? '' : ';transform:rotate(-.35deg)'),\n      revealState: s.revealed ? 'REVEALED · auto-remask in 30 s' : 'masked by default',\n      revealColor: s.revealed ? '#b3261e' : '#5c5344',\n      toggleReveal: () => this.setState({ revealed: !s.revealed }),\n      revealBtnBg: s.revealed ? '#e02020' : '#ffde59',\n      revealBtnInk: s.revealed ? '#ffffff' : '#121212',\n      revealBtnText: s.revealed ? 'Hide now' : 'Reveal for 30 s',\n      revealNote: s.revealed\n        ? 'While words are on screen the panel is straight, has no sticker, and carries the red reveal border. That is §6 calm, applied per-panel instead of per-realm.'\n        : 'Masked by default. No copy action, no download, nothing crosses the boundary. The slight tilt is the only whimsy, and it goes the moment you reveal.',\n      secretFacts: [\n        { k: 'Label', v: sec.label, note: 'Your own name for this secret. Stored with the vault record, never derived from the phrase.' },\n        { k: 'Master fingerprint', v: sec.fp, note: 'The public identifier for this seed. Safe to write on paper and compare against a device — it cannot be used to recover the phrase.' },\n        { k: 'Words', v: sec.words + ' · English', note: 'Length and wordlist. A 12-word phrase is 128 bits and is not meaningfully weaker in practice; 24 words is 256 bits.' },\n        { k: 'Passphrase', v: 'set · confirmed', note: 'A separate secret. The same words with a different passphrase are a different wallet, and no share scheme in Split lab backs it up for you.' },\n        { k: 'Released', v: '14:02 this session', note: 'When this secret entered memory in this frame. It leaves on lock, on five idle minutes, or on panic.' },\n        { k: 'Scope', v: 'cold realm only', note: 'This secret exists inside the sealed frame. It is not in the warm shell, not in the vault file unless you saved it, and not on any network.' }\n      ].map(f => ({\n        k: f.k, v: f.v,\n        go: this.factPop(f.k, f.v, f.note, /^(bc1|0x|zpub|xpub|[0-9A-F]{8}$)/.test(f.v))\n      })),\n      readyPanelStyle: 'padding:15px;border:3px solid #121212;border-radius:9px;background:#fff2f7;box-shadow:6px 6px 0 #000',\n      jumpLinks: [\n        { label: 'Derivation paths', meta: '41 ready', go: this.nav('paths') },\n        { label: 'Addresses', meta: 'gap clean', go: this.nav('addresses') },\n        { label: 'Child seeds', meta: 'index 3', go: this.nav('children') },\n        { label: 'Split lab', meta: '3-of-5', go: this.nav('shares') },\n        { label: 'SeedQR', meta: 'ready', go: this.nav('qr') }\n      ],\n\n      hasFilters: !!sc.filters, filters,\n      // Derived views name their source, so a stale table is visibly stale.\n      tableMeta: (sc.tableMeta || '').split('3A9F2C41').join(sec.fp).split('Steel plate').join(sec.label),\n      tableCols: sc.cols || '1fr', tableCells: cells, tableNote: sc.note || '',\n\n      gridCols: sc.gridCols || 'repeat(3,minmax(0,1fr))',\n      gridCards: (sc.cards || []).map((c, i) => {\n        const key = c[7];\n        // Every card opens a bubble. A named key uses a written pop; anything\n        // else gets one built from the card's own fields, so the interaction\n        // is identical everywhere rather than only on the cards I hand-wrote.\n        const scannable = /^(bc1|0x|zpub|xpub|ypub|Zpub|npub|sp1)/.test(String(c[2]));\n        const auto = ['speech', c[1], c[5], c[4] || 'Detail for this record, kept in the same place the summary lives.',\n          [['Item', c[0], sc.title], ['Value', c[2], ''], ['State', c[3], ''],\n           ['Screen', sc.title, sc.kicker], ['Source', sc.foot, '']],\n          'Everything Coldbox holds about this record. Where a value can be acted on, the send-to row below hands it straight to the tool that needs it.',\n          scannable ? c[2] : null, SEND[sc.sendKind || (scannable ? 'address' : 'wallet')]];\n        const go = key\n          ? () => this.setState({ pop: key, expand: false })\n          : () => this.setState({ pop: 'custom', popData: auto, expand: false });\n        return {\n          tag: c[0], title: c[1], value: c[2], meta: c[3],\n          note: (c[4] ? c[4] + '  ' : '') + '▸ tap for detail', hasNote: true,\n          tagBg: c[5], metaColor: c[6], go,\n          style: 'padding:14px 15px;border:3px solid #121212;border-radius:9px;background:' + paperStocks[i % 3]\n            + ';box-shadow:7px 7px 0 #000;cursor:pointer'\n        };\n      }),\n\n      schemeTabs: Object.keys(SCHEMES).map(k => ({\n        label: SCHEMES[k][0], go: () => this.setState({ scheme: k, revealed: false }), style: this.pill(s.scheme === k, '#00f0ff')\n      })),\n      schemeMeta: s.scheme === 'xor' ? shareTotal + ' parts · all required' : shareThr + ' of ' + shareTotal,\n      schemeCopy: scheme[2], shareCards,\n      splitTabs: ['Split a secret', 'Combine · recover'].map((t, i) => ({\n        label: t, go: () => this.setState({ splitTab: i, revealed: false, combined: false }),\n        style: this.pill((s.splitTab || 0) === i, '#ffde59')\n      })),\n      isSplitTab: (s.splitTab || 0) === 0, isCombine: (s.splitTab || 0) === 1,\n      secretLabel: sec.label, secretFp: sec.fp,\n      splitControls: splitCtl,\n      doGenerate: () => this.setState({ generated: !s.generated, revealed: false }),\n      genBtnLabel: s.generated ? 'Regenerate shares' : 'Generate shares',\n      splitStatus: s.generated\n        ? shareTotal + ' shares generated · nothing stored'\n        : 'no shares generated in this session',\n      splitSummaryStyle: 'padding:16px;border:3px solid ' + (s.scheme === 'xor' ? '#e02020' : '#121212')\n        + ';border-radius:9px;background:' + (s.scheme === 'xor' ? '#fff2f7' : '#e8f9ff') + ';box-shadow:6px 6px 0 #000;color:#121212',\n      splitSummaryBadge: s.scheme === 'xor' ? 'No threshold' : 'Threshold set',\n      splitSummaryBg: s.scheme === 'xor' ? '#e02020' : '#4ade80',\n      splitSummaryTitle: s.scheme === 'xor'\n        ? 'All ' + shareTotal + ' parts required'\n        : 'Any ' + shareThr + ' of ' + shareTotal + ' recovers',\n      splitFacts: [\n        { k: 'Scheme', v: scheme[0], color: '#121212', note: scheme[2] },\n        { k: 'Shares to hold', v: String(shareTotal), color: '#121212', note: 'How many physical things you will be storing. Each one needs a place that can fail independently of the others.' },\n        { k: 'Shares to recover', v: s.scheme === 'xor' ? 'all ' + shareTotal : String(shareThr), color: s.scheme === 'xor' ? '#b3261e' : '#0f6b45', note: s.scheme === 'xor' ? 'Seed XOR has no threshold. Every part is required, so losing one loses the wallet.' : 'Any ' + shareThr + ' of these reconstruct the wallet completely. Fewer than ' + shareThr + ' reveal nothing.' },\n        { k: 'Can lose safely', v: s.scheme === 'xor' ? 'none' : String(shareTotal - shareThr), color: s.scheme === 'xor' ? '#b3261e' : '#0f6b45', note: 'Fire, flood, a house move, a relative who throws things out. This number is your margin for all of it.' },\n        { k: 'Restorable on', v: s.scheme === 'slip39' ? 'Trezor only' : s.scheme === 'xor' ? 'Coldcard' : 'Coldbox / manual', color: '#5c5344', note: 'Which hardware can restore this set directly. Anything else means reconstructing in software first, which puts the phrase on a computer.' },\n        { k: 'Passphrase covered', v: 'no — back it up separately', color: '#b3261e', note: 'No scheme here splits the passphrase. If the passphrase is lost, every share becomes useless — this is the most common way a careful backup still fails.' }\n      ].map(f => ({ k: f.k, v: f.v, color: f.color, go: this.factPop(f.k, f.v, f.note, false) })),\n      splitWarning: s.scheme === 'xor'\n        ? 'Seed XOR has no threshold. Lose one part and the wallet is gone, so the parts must be in places that fail independently — not the same house, not the same safe.'\n        : shareTotal - shareThr === 0\n          ? 'With threshold equal to total, this behaves like an all-parts split: one lost share is a lost wallet.'\n          : 'You can lose ' + (shareTotal - shareThr) + ' share' + (shareTotal - shareThr === 1 ? '' : 's')\n            + ' and still recover, but any ' + shareThr + ' together reconstruct the wallet — so ' + shareThr + ' in one place is the same as no split at all.',\n      goCombine: () => this.setState({ splitTab: 1, revealed: false, combined: false }),\n      goBackupHealth: () => this.setState({ screen: 'backuphealth' }),\n      combineNeed: s.scheme === 'xor' ? 'all 4 parts required · order does not matter'\n        : s.scheme === 'codex32' ? 'exactly 3 shares · one per line'\n          : 'at least 3 of 5 · order does not matter',\n      combineState: s.combined ? 'reconstructed' : 'nothing combined yet',\n      combineColor: s.combined ? '#0f6b45' : '#5c5344',\n      combineFields: (s.scheme === 'xor' ? ['Part A', 'Part B', 'Part C', 'Part D'] : ['Share 1', 'Share 2', 'Share 3']).map((L, i) => ({\n        label: L + (s.scheme === 'codex32' ? ' · bech32 string' : ' · masked'),\n        value: s.combined ? '•••••• •••••• •••••• •••••• •••••• ••••••' : (i < 2 ? '•••••• •••••• •••••• •••••• •••••• ••••••' : 'empty'),\n        border: s.combined ? '#0f6b45' : (i < 2 ? '#121212' : '#b9b0a0'),\n        note: s.combined ? 'accepted · checksum valid' : (i < 2 ? 'looks well-formed' : 'waiting for input'),\n        noteColor: s.combined ? '#0f6b45' : (i < 2 ? '#0f6b45' : '#5c5344')\n      })),\n      doCombine: () => this.setState({ combined: !s.combined, revealed: false }),\n      combineBtn: s.combined ? 'Clear and start again' : 'Combine shares',\n      combineResultStyle: 'padding:16px;border:3px solid ' + (s.combined ? (s.revealed ? '#e02020' : '#0f6b45') : '#121212')\n        + ';border-radius:9px;background:#fffdf5;box-shadow:6px 6px 0 #000;color:#121212',\n      combineBadge: s.combined ? 'Reconstructed' : 'Not reconstructed',\n      combineBadgeBg: s.combined ? '#4ade80' : '#efece2',\n      combineBadgeInk: '#121212',\n      combineOut: !s.combined\n        ? 'Nothing yet. Enter the threshold number of shares.'\n        : s.revealed\n          ? (s.scheme === 'codex32'\n            ? 'a3f19c40 8b2d7e51 0f64c9aa 27d5b183 e91c46f0 5a8b32dc'\n            : 'ripple canyon velvet oyster timber plunge ladder nectar quarry siphon walnut orbit')\n          : '•••••• •••••• •••••• •••••• •••••• ••••••',\n      combineFp: s.combined ? 'fingerprint 3A9F2C41 · matches the set you split' : 'no fingerprint',\n      combineNote: s.combined\n        ? 'Always check the reconstructed fingerprint against the one you recorded. Wrong or damaged shares can reconstruct a plausible but incorrect candidate, and only the fingerprint or the BIP-39 checksum catches that.'\n        : (s.scheme === 'shamir39'\n          ? 'Raw SSS and Shamir39 have no share authentication, so a bad share produces a wrong answer rather than an error. Verify the result independently.'\n          : 'Enter the threshold and combine. Nothing is stored, and the fields clear afterwards either way.'),\n      hasCorrection: s.scheme === 'codex32',\n      combineReleaseBg: s.combined ? '#4ade80' : '#8e8e9c',\n      combineReleaseLabel: s.combined ? 'Release reconstructed secret' : 'Combine first',\n      verifyCopy: 'Reconstruct from the threshold and compare fingerprints before this set counts as a backup. Nothing is stored for you, and no share is ever written to the vault.',\n\n      qrModules,\n      qrFacts: [\n        { k: 'Encoding', v: 'BIP-39 indices · 4-digit groups', note: 'Each word becomes its 4-digit index in the wordlist. This is why a SeedQR can be transcribed by hand from the printed grid if the code is ever damaged.' },\n        { k: 'Modules', v: '21 x 21 · version 1', note: 'The smallest QR version. Compact mode packs the same phrase into fewer modules, which scans faster but cannot be read by eye.' },\n        { k: 'Source', v: sec.fp, note: 'The secret this code encodes: ' + sec.label + '. Switch the focused secret above and this code regenerates.' },\n        { k: 'Layout', v: 'wallet-sized 24-word card', note: 'Sized for a steel plate or a card in a sleeve. The transcription grid sits beside the code so a damaged code can still be read.' },\n        { k: 'Grid', v: 'numbered transcription cells: on', note: 'Numbered cells so a person can copy the words back in order without losing their place.' }\n      ].map(f => ({ k: f.k, v: f.v, go: this.factPop(f.k, f.v, f.note, f.k === 'Source') })),\n\n      meters: meterData,\n      sources: sourceCards,\n      healthLabel: health.label, healthBg: health.bg, healthBorder: health.border,\n      healthStats: health.stats, healthNote: health.note,\n      resetAll: () => this.setState({ ent: { dice: [], coin: [], cards: [], hex: [], csprng: 0 } }),\n      mixGo: () => {\n        // Deterministic stand-in for the real mix: a hex string of the selected\n        // width, derived from what was actually collected.\n        const seedStr = ent.dice.join('') + ent.coin.join('') + ent.cards.join('') + ent.hex.join('') + ent.csprng + target;\n        let h = 2166136261;\n        let out = '';\n        for (let i = 0; i < target / 4; i++) {\n          h = (h ^ (seedStr.charCodeAt(i % Math.max(1, seedStr.length)) || 61)) * 16777619 % 2147483647;\n          out += '0123456789abcdef'[Math.abs(h + i * 7) % 16];\n        }\n        this.setState({ mixed: out });\n      },\n      mixBg: indep >= target ? '#4ade80' : '#ffde59',\n      mixLabel: indep >= target ? 'Mix entropy' : 'Mix anyway',\n      targetTabs: TARGETS.map((t, i) => ({\n        label: t[1], bits: t[0] + ' bits',\n        go: () => this.setState({ target: i }),\n        style: 'padding:8px 12px;border:' + ((s.target === undefined ? 4 : s.target) === i ? '3px' : '2px')\n          + ' solid ' + ((s.target === undefined ? 4 : s.target) === i ? '#000' : '#f4f0e2') + ';border-radius:6px;background:'\n          + ((s.target === undefined ? 4 : s.target) === i ? '#00f0ff' : '#1e1e2b') + ';box-shadow:'\n          + ((s.target === undefined ? 4 : s.target) === i ? '3px 3px 0 #000' : 'none') + ';color:'\n          + ((s.target === undefined ? 4 : s.target) === i ? '#121212' : '#b3bcd4') + ';cursor:pointer;min-height:46px'\n      })),\n      hasMix: !!s.mixed,\n      mixHex: s.mixed || '',\n      mixMeta: (s.mixed || '').length * 4 + ' bits · ' + TARGETS[s.target === undefined ? 4 : s.target][1]\n        + ' · ' + indep + ' independent + ' + (ent.csprng * 8) + ' CSPRNG',\n      useMix: () => this.setState({ screen: 'forge', revealed: false }),\n      releasePanelStyle: 'padding:17px 18px 18px;border:3px solid #121212;border-radius:9px;background:#e8f9ff;box-shadow:8px 8px 0 #000;color:#121212',\n\n      stageCards: [\n        {\n          title: 'Warm shell', badge: 'Online ok', badgeBg: '#00f0ff', sub: 'The outer document. This one.',\n          rows: [\n            { name: 'Prices', note: 'Median of five sources', value: 'Phase 3', color: '#5c5344' },\n            { name: 'Portfolio', note: 'Lots and cost basis', value: 'Phase 3', color: '#5c5344' },\n            { name: 'Registry', note: 'Addresses and labels', value: 'Phase 1', color: '#5c5344' }\n          ],\n          hasBubble: true, bubble: 'It can reach the network for public data. It never receives a secret.', hasSticker: false, sticker: '',\n          style: 'position:relative;flex:0 0 auto;width:296px;margin:0 -8px;padding:16px 17px 17px;border:3px solid #000;border-radius:9px;background:#e8f9ff;box-shadow:8px 8px 0 #000;transform:rotateY(22deg) translateZ(0) scale(.94);transition:transform 380ms cubic-bezier(.18,.89,.32,1.15)',\n          hover: 'transform:rotateY(7deg) translateZ(30px) scale(.99);z-index:11'\n        },\n        {\n          title: 'Coldbox', badge: 'Companion', badgeBg: '#4ade80', sub: 'Toolkit · wallet registry · portfolio manager',\n          rows: [\n            { name: 'Holds your keys', note: 'Your hardware wallet does', value: 'No', color: '#b3261e' },\n            { name: 'Signs transactions', note: 'Permanent non-goal', value: 'No', color: '#b3261e' },\n            { name: 'Verifies your device', note: 'Catches address swaps', value: 'Yes', color: '#0f6b45' }\n          ],\n          hasBubble: true, bubble: 'It cannot spend your money — so an attacker who compromises it cannot either.',\n          hasSticker: true, sticker: 'Not a wallet!',\n          style: 'position:relative;flex:0 0 auto;width:310px;margin:0 -8px;padding:16px 17px 17px;border:3px solid #000;border-radius:9px;background:#fffdf5;box-shadow:9px 9px 0 #000;z-index:10;transform:translateZ(56px);transition:transform 380ms cubic-bezier(.18,.89,.32,1.15)',\n          hover: 'transform:translateZ(76px) scale(1.02)'\n        },\n        {\n          title: 'Sealed realm', badge: 'No network', badgeBg: '#ff007a', sub: 'A sandboxed iframe with its own policy.',\n          rows: [\n            { name: 'Seed Forge', note: 'BIP-39 generate and check', value: 'P1.3', color: '#5c5344' },\n            { name: 'Backup Lab', note: 'SLIP-39, codex32, XOR', value: 'Phase 2', color: '#5c5344' },\n            { name: 'Vault', note: 'Argon2id + AES-256-GCM', value: 'Active', color: '#0f6b45' }\n          ],\n          hasBubble: true, bubble: \"connect-src 'none' — no fetch, no XHR, no socket. Not disabled. Absent.\", hasSticker: false, sticker: '',\n          style: 'position:relative;flex:0 0 auto;width:296px;margin:0 -8px;padding:16px 17px 17px;border:3px solid #000;border-radius:9px;background:#fff2f7;box-shadow:8px 8px 0 #000;transform:rotateY(-22deg) translateZ(0) scale(.94);transition:transform 380ms cubic-bezier(.18,.89,.32,1.15)',\n          hover: 'transform:rotateY(-7deg) translateZ(30px) scale(.99);z-index:11'\n        }\n      ],\n      infoCards: [\n        { n: '01', title: 'One shell, two permissions', body: 'The rail, the masthead, the buttons and the halftone are identical in both realms. What changes is the striped boundary strip and whether a secret switcher exists. Nothing about the visual language announces \"you have left the app\".' },\n        { n: '02', title: 'The secret is the subject', body: 'Release once in the Forge and every cold tool becomes a lens on that secret. Eleven phrase fields collapse into one, which removes eleven chances to paste a seed into the wrong box.' },\n        { n: '03', title: 'Calm arrives per panel', body: 'Instead of banning motion from the whole realm, §6 applies to the panel that holds the secret: it straightens, drops its sticker and takes the red border the moment words are visible.' }\n      ]\n    };\n  }\n}\n\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>